# Huddle PRODUCTION environment (docker-compose.prod.yml). Copy to .env.production
# and fill in. Never commit .env.production (it is gitignored).
#
#   cp .env.production.example .env.production
#
# Used twice by compose: `--env-file .env.production` (interpolation, e.g.
# POSTGRES_PASSWORD) and `env_file:` (runtime env for web, worker and migrate).
# DATABASE_URL and AVATAR_DIR are set by docker-compose.prod.yml itself, so they
# are deliberately absent here.

# --- Database ---
# Password for the bundled Postgres (user/db `huddle`). Required, no default.
# It is embedded in a connection URL, so use URL-safe characters: hex is the easy way.
#   openssl rand -hex 24
# Only takes effect when the pgdata volume is first created; changing it later
# means ALTER USER inside Postgres as well (see DEPLOY.md).
POSTGRES_PASSWORD=

# --- Auth (Auth.js v5) ---
# Public ORIGIN of the site: scheme + host only. No path, no trailing slash.
# Auth.js derives its API base path from the pathname of this URL, so a path
# here silently breaks the whole auth API (the alpha-chat NEXTAUTH_URL lesson).
AUTH_URL=https://huddle.anishsaranga.com
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URIs: https://huddle.anishsaranga.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ---
# Public base URL of the app (no trailing slash). Used to build the ingest URL
# shown in Setup and other absolute links.
APP_URL=https://huddle.anishsaranga.com
# The one email that is always allowed in and is the only admin (case-insensitive).
ADMIN_EMAIL=you@example.com
# Pepper for hashing API keys. Generate with: openssl rand -base64 32
# WARNING: rotating this invalidates EVERY existing API key (only HMACs are
# stored), so every user's iPhone Shortcut stops working until they regenerate
# their key. Set it once and back it up.
API_KEY_PEPPER=

# --- AI (Gemini) ---
# Optional: without a key the weekly champions post falls back to a template.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- iOS Shortcut ---
SHORTCUT_NAME=Huddle Sync
# Optional iCloud share link for the Shortcut (must be a URL if set).
SHORTCUT_ICLOUD_URL=

# --- Logging / retention ---
# trace | debug | info | warn | error | fatal. JSON lines on stdout: docker logs huddle-prod-web
LOG_LEVEL=info
# Days to keep ingest log rows.
INGEST_LOG_RETENTION_DAYS=90

# Do NOT set E2E_AUTH here (test-only login bypass; impossible in production builds anyway).
