# Huddle environment. Copy to .env and fill in. Never commit .env.

# --- Database (required) ---
# Dev DB from docker-compose.yml (host port 5433). Test DB is huddle_test.
DATABASE_URL=postgres://huddle:huddle@localhost:5433/huddle

# --- Auth (Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
# Without these, "Continue with Google" logs an error and shows a notice.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ---
# Email that is always allowed in and always admin (case-insensitive).
# Nobody else is ever admin; is_admin is re-synced on every sign-in.
ADMIN_EMAIL=you@example.com
# Pepper for hashing API keys. Generate with: openssl rand -base64 32
API_KEY_PEPPER=change-me
# Public base URL of the app (no trailing slash)
APP_URL=http://localhost:3000

# --- Avatars ---
# Where uploaded avatar photos live (data/ is gitignored).
# Default: ./data/avatars in dev, /data/avatars in production.
AVATAR_DIR=

# --- AI (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- iOS Shortcut ---
SHORTCUT_NAME=Huddle Sync
# Optional iCloud share link for the Shortcut (must be a URL if set)
SHORTCUT_ICLOUD_URL=

# --- Logging ---
# trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=debug
# Days to keep ingest log rows (default: 90)
INGEST_LOG_RETENTION_DAYS=90

# --- Tests ---
# Never set E2E_AUTH here: Playwright sets E2E_AUTH=1 on its own dev server
# (enables POST /api/test/login; impossible in production builds). See docs/dev.md.
# Integration/e2e database (name must end in _test):
# TEST_DATABASE_URL=postgres://huddle:huddle@localhost:5433/huddle_test
